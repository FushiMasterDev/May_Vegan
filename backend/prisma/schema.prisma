// Mây Vegan — Prisma schema
// Nguồn sự thật cho cấu trúc bảng là database/schema.sql (áp trực tiếp bằng
// mysql client). File này được giữ đồng bộ thủ công với schema.sql (đã xác
// nhận khớp 1-1 qua `prisma db pull` khi thay đổi bảng), chỉ đổi tên
// model/field sang PascalCase/camelCase (qua @@map/@map) cho code TypeScript
// idiomatic hơn — không đổi tên bảng/cột thật trong MySQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  name        String   @unique(map: "uq_roles_name") @db.VarChar(30)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.DateTime(0)
  users       User[]

  @@map("roles")
}

model User {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  roleId        Int      @map("role_id") @db.UnsignedInt
  fullName      String   @map("full_name") @db.VarChar(100)
  email         String   @unique(map: "uq_users_email") @db.VarChar(150)
  phone         String?  @unique(map: "uq_users_phone") @db.VarChar(20)
  passwordHash  String   @map("password_hash") @db.VarChar(255)
  avatarUrl     String?  @map("avatar_url") @db.VarChar(500)
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime? @map("last_login_at") @db.DateTime(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.DateTime(0)

  role                   Role                    @relation(fields: [roleId], references: [id], map: "fk_users_role")
  customer               Customer?
  employee               Employee?
  notifications          Notification[]
  inventoryTransactions  InventoryTransaction[]

  @@index([roleId], map: "idx_users_role")
  @@index([status], map: "idx_users_status")
  @@map("users")
}

model Customer {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  userId        Int      @unique(map: "uq_customers_user") @map("user_id") @db.UnsignedInt
  address       String?  @db.VarChar(500)
  loyaltyPoints Int      @default(0) @map("loyalty_points") @db.UnsignedInt
  totalOrders   Int      @default(0) @map("total_orders") @db.UnsignedInt
  totalSpent    Decimal  @default(0.00) @map("total_spent") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.DateTime(0)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_customers_user")
  orders        Order[]
  reservations  Reservation[]
  reviews       Review[]
  couponUsages  CouponUsage[]

  @@map("customers")
}

model Employee {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  userId        Int      @unique(map: "uq_employees_user") @map("user_id") @db.UnsignedInt
  employeeCode  String   @unique(map: "uq_employees_code") @map("employee_code") @db.VarChar(20)
  position      String   @db.VarChar(100)
  hiredAt       DateTime? @map("hired_at") @db.Date
  status        EmployeeStatus @default(ACTIVE)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.DateTime(0)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_employees_user")
  orders Order[]

  @@map("employees")
}

model Supplier {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  name          String   @db.VarChar(150)
  contactPerson String?  @map("contact_person") @db.VarChar(100)
  phone         String?  @db.VarChar(20)
  email         String?  @db.VarChar(150)
  address       String?  @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.DateTime(0)

  ingredients Ingredient[]

  @@map("suppliers")
}

model Category {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  name          String   @db.VarChar(100)
  slug          String   @unique(map: "uq_categories_slug") @db.VarChar(120)
  description   String?  @db.VarChar(500)
  displayOrder  Int      @default(0) @map("display_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.DateTime(0)

  products Product[]

  @@map("categories")
}

/// products has DB-level CHECK constraints (chk_products_price, chk_products_sale_price)
/// not represented here — enforced by MySQL, not by Prisma Client.
model Product {
  id              Int      @id @default(autoincrement()) @db.UnsignedInt
  categoryId      Int      @map("category_id") @db.UnsignedInt
  name            String   @db.VarChar(150)
  slug            String   @unique(map: "uq_products_slug") @db.VarChar(180)
  description     String?  @db.Text
  ingredientsText String?  @map("ingredients_text") @db.VarChar(500)
  calories        Int?     @db.UnsignedSmallInt
  allergyInfo     String?  @map("allergy_info") @db.VarChar(255)
  price           Decimal  @db.Decimal(12, 2)
  salePrice       Decimal? @map("sale_price") @db.Decimal(12, 2)
  status          ProductStatus @default(AVAILABLE)
  isFeatured      Boolean  @default(false) @map("is_featured")
  isBestSeller    Boolean  @default(false) @map("is_best_seller")
  ratingAvg       Decimal  @default(0.0) @map("rating_avg") @db.Decimal(2, 1)
  ratingCount     Int      @default(0) @map("rating_count") @db.UnsignedInt
  soldCount       Int      @default(0) @map("sold_count") @db.UnsignedInt
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.DateTime(0)

  category   Category       @relation(fields: [categoryId], references: [id], map: "fk_products_category")
  images     ProductImage[]
  orderItems OrderItem[]
  reviews    Review[]

  @@index([categoryId], map: "idx_products_category")
  @@index([status], map: "idx_products_status")
  @@index([isFeatured], map: "idx_products_featured")
  @@index([isBestSeller], map: "idx_products_best_seller")
  @@index([name], map: "idx_products_name")
  @@map("products")
}

model ProductImage {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  productId     Int      @map("product_id") @db.UnsignedInt
  imageUrl      String   @map("image_url") @db.VarChar(500)
  isPrimary     Boolean  @default(false) @map("is_primary")
  displayOrder  Int      @default(0) @map("display_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, map: "fk_product_images_product")

  @@index([productId], map: "idx_product_images_product")
  @@map("product_images")
}

/// ingredients has a DB-level CHECK constraint (chk_ingredients_stock) not
/// represented here — enforced by MySQL, not by Prisma Client.
model Ingredient {
  id                Int      @id @default(autoincrement()) @db.UnsignedInt
  code              String   @unique(map: "uq_ingredients_code") @db.VarChar(30)
  name              String   @db.VarChar(150)
  unit              String   @db.VarChar(20)
  quantityInStock   Decimal  @default(0.00) @map("quantity_in_stock") @db.Decimal(12, 2)
  minStockLevel     Decimal  @default(0.00) @map("min_stock_level") @db.Decimal(12, 2)
  costPrice         Decimal  @default(0.00) @map("cost_price") @db.Decimal(12, 2)
  supplierId        Int?     @map("supplier_id") @db.UnsignedInt
  importedAt        DateTime? @map("imported_at") @db.Date
  expiryDate        DateTime? @map("expiry_date") @db.Date
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.DateTime(0)

  supplier     Supplier?              @relation(fields: [supplierId], references: [id], map: "fk_ingredients_supplier")
  transactions InventoryTransaction[]

  @@index([supplierId], map: "idx_ingredients_supplier")
  @@index([name], map: "idx_ingredients_name")
  @@map("ingredients")
}

/// quantity là số lượng thay đổi có dấu (IMPORT > 0, EXPORT < 0, ADJUST/
/// STOCKTAKE dương hoặc âm tuỳ chiều điều chỉnh) — xem ghi chú trong schema.sql.
model InventoryTransaction {
  id           Int      @id @default(autoincrement()) @db.UnsignedInt
  ingredientId Int      @map("ingredient_id") @db.UnsignedInt
  type         InventoryTransactionType
  quantity     Decimal  @db.Decimal(12, 2)
  unitCost     Decimal? @map("unit_cost") @db.Decimal(12, 2)
  note         String?  @db.VarChar(500)
  createdBy    Int?     @map("created_by") @db.UnsignedInt
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)

  ingredient    Ingredient @relation(fields: [ingredientId], references: [id], map: "fk_inventory_tx_ingredient")
  createdByUser User?      @relation(fields: [createdBy], references: [id], map: "fk_inventory_tx_user")

  @@index([ingredientId], map: "idx_inventory_tx_ingredient")
  @@index([type], map: "idx_inventory_tx_type")
  @@index([createdAt], map: "idx_inventory_tx_created_at")
  @@map("inventory_transactions")
}

model RestaurantTable {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  code       String   @unique(map: "uq_tables_code") @db.VarChar(20)
  seats      Int      @db.UnsignedTinyInt
  area       String   @db.VarChar(100)
  status     TableStatus @default(AVAILABLE)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.DateTime(0)

  orders       Order[]
  reservations Reservation[]

  @@index([status], map: "idx_tables_status")
  @@index([area], map: "idx_tables_area")
  @@map("tables")
}

/// reservations has a DB-level CHECK constraint (chk_reservations_party_size)
/// not represented here — enforced by MySQL, not by Prisma Client.
model Reservation {
  id               Int      @id @default(autoincrement()) @db.UnsignedInt
  reservationCode  String   @unique(map: "uq_reservations_code") @map("reservation_code") @db.VarChar(30)
  customerId       Int?     @map("customer_id") @db.UnsignedInt
  guestName        String   @map("guest_name") @db.VarChar(100)
  guestPhone       String   @map("guest_phone") @db.VarChar(20)
  tableId          Int?     @map("table_id") @db.UnsignedInt
  partySize        Int      @map("party_size") @db.UnsignedTinyInt
  reservationDate  DateTime @map("reservation_date") @db.Date
  reservationTime  DateTime @map("reservation_time") @db.Time(0)
  area             String?  @db.VarChar(100)
  note             String?  @db.VarChar(500)
  status           ReservationStatus @default(PENDING)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.DateTime(0)

  customer Customer?        @relation(fields: [customerId], references: [id], map: "fk_reservations_customer")
  table    RestaurantTable? @relation(fields: [tableId], references: [id], map: "fk_reservations_table")

  @@index([reservationDate], map: "idx_reservations_date")
  @@index([status], map: "idx_reservations_status")
  @@index([tableId], map: "idx_reservations_table")
  @@map("reservations")
}

/// coupons has DB-level CHECK constraints (chk_coupons_dates, chk_coupons_value)
/// not represented here — enforced by MySQL, not by Prisma Client.
model Coupon {
  id                  Int      @id @default(autoincrement()) @db.UnsignedInt
  code                String   @unique(map: "uq_coupons_code") @db.VarChar(40)
  name                String   @db.VarChar(150)
  discountType        CouponDiscountType @map("discount_type")
  discountValue       Decimal  @map("discount_value") @db.Decimal(12, 2)
  minOrderAmount      Decimal  @default(0.00) @map("min_order_amount") @db.Decimal(12, 2)
  maxDiscountAmount   Decimal? @map("max_discount_amount") @db.Decimal(12, 2)
  startDate           DateTime @map("start_date") @db.Date
  endDate             DateTime @map("end_date") @db.Date
  usageLimit          Int?     @map("usage_limit") @db.UnsignedInt
  usedCount           Int      @default(0) @map("used_count") @db.UnsignedInt
  status              CouponStatus @default(ACTIVE)
  createdAt           DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt           DateTime @default(now()) @map("updated_at") @db.DateTime(0)

  orders Order[]
  usages CouponUsage[]

  @@index([status], map: "idx_coupons_status")
  @@map("coupons")
}

/// orders has a DB-level CHECK constraint (chk_orders_amounts) not
/// represented here — enforced by MySQL, not by Prisma Client.
model Order {
  id               Int      @id @default(autoincrement()) @db.UnsignedInt
  orderCode        String   @unique(map: "uq_orders_code") @map("order_code") @db.VarChar(30)
  customerId       Int?     @map("customer_id") @db.UnsignedInt
  tableId          Int?     @map("table_id") @db.UnsignedInt
  employeeId       Int?     @map("employee_id") @db.UnsignedInt
  couponId         Int?     @map("coupon_id") @db.UnsignedInt
  orderType        OrderType @map("order_type")
  status           OrderStatus @default(PENDING)
  guestName        String?  @map("guest_name") @db.VarChar(100)
  guestPhone       String?  @map("guest_phone") @db.VarChar(20)
  guestEmail       String?  @map("guest_email") @db.VarChar(150)
  deliveryAddress  String?  @map("delivery_address") @db.VarChar(500)
  note             String?  @db.VarChar(500)
  requestedTime    DateTime? @map("requested_time") @db.DateTime(0)
  subtotal         Decimal  @db.Decimal(12, 2)
  discountAmount   Decimal  @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  deliveryFee      Decimal  @default(0.00) @map("delivery_fee") @db.Decimal(12, 2)
  totalAmount      Decimal  @map("total_amount") @db.Decimal(12, 2)
  paymentMethod    PaymentMethod @default(CASH) @map("payment_method")
  paymentStatus    OrderPaymentStatus @default(UNPAID) @map("payment_status")
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.DateTime(0)

  customer     Customer?        @relation(fields: [customerId], references: [id], map: "fk_orders_customer")
  table        RestaurantTable? @relation(fields: [tableId], references: [id], map: "fk_orders_table")
  employee     Employee?        @relation(fields: [employeeId], references: [id], map: "fk_orders_employee")
  coupon       Coupon?          @relation(fields: [couponId], references: [id], map: "fk_orders_coupon")
  items        OrderItem[]
  payment      Payment?
  couponUsage  CouponUsage?
  reviews      Review[]

  @@index([customerId], map: "idx_orders_customer")
  @@index([status], map: "idx_orders_status")
  @@index([orderType], map: "idx_orders_type")
  @@index([createdAt], map: "idx_orders_created_at")
  @@map("orders")
}

/// order_items has a DB-level CHECK constraint (chk_order_items_quantity) not
/// represented here — enforced by MySQL, not by Prisma Client.
model OrderItem {
  id                    Int      @id @default(autoincrement()) @db.UnsignedInt
  orderId               Int      @map("order_id") @db.UnsignedInt
  productId             Int      @map("product_id") @db.UnsignedInt
  productNameSnapshot   String   @map("product_name_snapshot") @db.VarChar(150)
  unitPrice             Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity              Int      @db.UnsignedInt
  note                  String?  @db.VarChar(255)
  subtotal              Decimal  @db.Decimal(12, 2)
  createdAt             DateTime @default(now()) @map("created_at") @db.DateTime(0)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "fk_order_items_order")
  product Product @relation(fields: [productId], references: [id], map: "fk_order_items_product")

  @@index([orderId], map: "idx_order_items_order")
  @@index([productId], map: "idx_order_items_product")
  @@map("order_items")
}

model Payment {
  id              Int      @id @default(autoincrement()) @db.UnsignedInt
  orderId         Int      @unique(map: "uq_payments_order") @map("order_id") @db.UnsignedInt
  amount          Decimal  @db.Decimal(12, 2)
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  transactionRef  String?  @map("transaction_ref") @db.VarChar(100)
  paidAt          DateTime? @map("paid_at") @db.DateTime(0)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.DateTime(0)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "fk_payments_order")

  @@map("payments")
}

model CouponUsage {
  id              Int      @id @default(autoincrement()) @db.UnsignedInt
  couponId        Int      @map("coupon_id") @db.UnsignedInt
  orderId         Int      @unique(map: "uq_coupon_usages_order") @map("order_id") @db.UnsignedInt
  customerId      Int?     @map("customer_id") @db.UnsignedInt
  discountAmount  Decimal  @map("discount_amount") @db.Decimal(12, 2)
  usedAt          DateTime @default(now()) @map("used_at") @db.DateTime(0)

  coupon   Coupon    @relation(fields: [couponId], references: [id], map: "fk_coupon_usages_coupon")
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "fk_coupon_usages_order")
  customer Customer? @relation(fields: [customerId], references: [id], map: "fk_coupon_usages_customer")

  @@index([couponId], map: "idx_coupon_usages_coupon")
  @@map("coupon_usages")
}

/// reviews has a DB-level CHECK constraint (chk_reviews_rating) not
/// represented here — enforced by MySQL, not by Prisma Client.
model Review {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  productId   Int      @map("product_id") @db.UnsignedInt
  customerId  Int      @map("customer_id") @db.UnsignedInt
  orderId     Int?     @map("order_id") @db.UnsignedInt
  rating      Int      @db.UnsignedTinyInt
  comment     String?  @db.VarChar(1000)
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  status      ReviewStatus @default(VISIBLE)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.DateTime(0)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade, map: "fk_reviews_product")
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, map: "fk_reviews_customer")
  order    Order?   @relation(fields: [orderId], references: [id], map: "fk_reviews_order")

  @@index([productId], map: "idx_reviews_product")
  @@index([customerId], map: "idx_reviews_customer")
  @@index([status], map: "idx_reviews_status")
  @@map("reviews")
}

model Notification {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  userId     Int      @map("user_id") @db.UnsignedInt
  title      String   @db.VarChar(150)
  message    String   @db.VarChar(1000)
  type       String   @db.VarChar(30)
  isRead     Boolean  @default(false) @map("is_read")
  link       String?  @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_notifications_user")

  @@index([userId], map: "idx_notifications_user")
  @@index([isRead], map: "idx_notifications_is_read")
  @@map("notifications")
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  AVAILABLE
  OUT_OF_STOCK
  HIDDEN
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  MAINTENANCE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
}

enum CouponDiscountType {
  PERCENT
  AMOUNT
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum OrderType {
  DINE_IN
  DELIVERY
  PICKUP
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERING
  COMPLETED
  CANCELLED
}

/// Dùng chung cho orders.paymentMethod và payments.method
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  ONLINE
}

/// orders.paymentStatus — trạng thái thanh toán ở mức đơn hàng
enum OrderPaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

/// payments.status — trạng thái của một giao dịch thanh toán cụ thể
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
}

enum InventoryTransactionType {
  IMPORT
  EXPORT
  ADJUST
  STOCKTAKE
}
