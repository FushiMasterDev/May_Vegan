# Server
NODE_ENV=development
PORT=4000

# Database (MySQL) - used by Prisma
# format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/mayvegan"

# JWT
JWT_ACCESS_SECRET="change-this-access-secret-in-local-env"
JWT_REFRESH_SECRET="change-this-refresh-secret-in-local-env"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173
