# Server
NODE_ENV=development
PORT=4000

# Database (PostgreSQL) - used by Prisma
# format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Ví dụ: dùng free tier của Neon (neon.tech) — copy connection string từ dashboard.
DATABASE_URL="postgresql://user:<password>@host.neon.tech/dbname?sslmode=require"

# JWT — tạo secret ngẫu nhiên, ví dụ: openssl rand -hex 32
JWT_ACCESS_SECRET="change-this-access-secret-in-local-env"
JWT_REFRESH_SECRET="change-this-refresh-secret-in-local-env"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173
